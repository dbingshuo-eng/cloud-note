.state-card {
  margin: 36rpx 0;
  padding: 64rpx 40rpx;
  border: 2rpx dashed rgba(22, 35, 61, 0.22);
  border-radius: 24rpx;
  background: rgba(255, 252, 245, 0.58);
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.spinner {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid rgba(22, 35, 61, 0.15);
  border-top-color: #e8a33a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.state-mark {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  color: #fffaf0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.empty-mark {
  background: #657189;
}

.error-mark {
  background: #a0443d;
}

.state-title {
  color: #172036;
  font-size: 32rpx;
  font-weight: 700;
}

.state-message {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: #667087;
  font-size: 25rpx;
  line-height: 1.6;
}

.state-action {
  min-width: 184rpx;
  min-height: 88rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: #16233d;
  color: #fffaf0;
  font-size: 27rpx;
  line-height: 88rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .spinner {
    animation: none;
  }
}
