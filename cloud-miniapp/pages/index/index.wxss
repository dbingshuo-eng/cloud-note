.index-page {
  min-height: 100vh;
  padding: 18rpx 22rpx calc(116rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  color: #1d1d1f;
}

.topbar {
  min-height: 128rpx;
  padding: 0 4rpx 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.brand-block {
  flex: 1 1 0;
  min-width: 0;
  padding-right: 20rpx;
}

.eyebrow {
  display: block;
  white-space: nowrap;
  color: #8e8e93;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  color: #1d1d1f;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.15;
  white-space: nowrap;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 23rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.topbar-actions,
.hero-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 24rpx;
}

.text-button {
  min-width: 82rpx;
  min-height: 66rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  background: transparent;
  color: #0a84ff;
  font-size: 27rpx;
  line-height: 66rpx;
  white-space: nowrap;
}

.manage-button {
  display: flex;
  flex: 0 0 132rpx;
  width: 132rpx !important;
  min-width: 132rpx !important;
  max-width: 132rpx !important;
  margin: 0;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #0a84ff;
  color: #ffffff;
  font-weight: 700;
}

.muted-text-button {
  display: flex;
  flex: 0 0 76rpx;
  width: 76rpx !important;
  min-width: 76rpx !important;
  max-width: 76rpx !important;
  margin: 0;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  color: #8e8e93;
}

.search-bar {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 82rpx;
  margin: -2rpx 0 18rpx;
  padding: 0 10rpx 0 26rpx;
  border: 2rpx solid #e5e5ea;
  border-radius: 22rpx;
  background: #ffffff;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 78rpx;
  color: #1d1d1f;
  font-size: 27rpx;
}

.search-placeholder {
  color: #aeaeb2;
}

.clear-search,
.search-submit {
  flex: 0 0 auto;
  min-width: 62rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 0;
  border-radius: 16rpx;
  background: transparent;
  color: #0a84ff;
  font-size: 25rpx;
  line-height: 64rpx;
}

.search-submit {
  display: flex;
  flex: 0 0 126rpx;
  width: 126rpx !important;
  min-width: 126rpx !important;
  max-width: 126rpx !important;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  background: #0a84ff;
  color: #ffffff;
  font-weight: 700;
}

.clear-search {
  position: absolute;
  top: 9rpx;
  right: 138rpx;
  z-index: 1;
  width: 54rpx !important;
  min-width: 54rpx;
  padding: 0 !important;
  color: #8e8e93;
  font-size: 30rpx;
}

.breadcrumbs {
  width: 100%;
  height: 42rpx;
  margin: -8rpx 0 14rpx;
  white-space: nowrap;
}

.breadcrumb,
.breadcrumb-separator {
  display: inline-block;
  color: #8e8e93;
  font-size: 23rpx;
  line-height: 42rpx;
}

.current-breadcrumb {
  color: #1d1d1f;
  font-weight: 600;
}

.breadcrumb-separator {
  margin: 0 10rpx;
  color: #c7c7cc;
}

.workspace-card {
  padding: 16rpx 18rpx 18rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(29, 29, 31, 0.06);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  padding-bottom: 9rpx;
  border-bottom: 1rpx solid #f0f0f2;
}

.mode-button,
.sort-button,
.order-button {
  min-height: 64rpx;
  margin: 0;
  border: 1rpx solid #e5e5ea;
  border-radius: 17rpx;
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 62rpx;
  white-space: nowrap;
}

.mode-button {
  display: flex;
  flex: 0 0 auto;
  width: 184rpx;
  max-width: 184rpx;
  overflow: hidden;
  padding: 0 16rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  text-overflow: ellipsis;
}

.mode-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #0a84ff;
}

.sort-controls {
  flex: 0 0 auto;
  min-width: 0;
  margin-left: auto;
  display: flex;
  gap: 8rpx;
}

.sort-button {
  width: 246rpx;
  max-width: 246rpx;
  padding: 0 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.order-button {
  flex: 0 0 64rpx;
  width: 64rpx;
  max-width: 64rpx;
  padding: 0;
  color: #0a84ff;
  font-size: 28rpx;
  font-weight: 700;
}

.file-list {
  margin-top: 4rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 10rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.2;
}

.list-header text:last-child {
  width: 190rpx;
  text-align: right;
}

.file-row {
  position: relative;
  min-height: 112rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
  display: flex;
  align-items: flex-start;
  transition: background-color 160ms ease, transform 160ms ease;
}

.recycle-file-row {
  min-height: 112rpx;
  padding-bottom: 82rpx;
}

.file-row-pressed {
  background: #f0f7ff;
}

.file-row:last-child {
  border-bottom: 0;
}

.manage-file-row {
  min-height: 82rpx;
  padding: 14rpx 0 14rpx 68rpx;
}

.selected-file-row {
  margin: 0 -10rpx;
  padding-right: 10rpx;
  padding-left: 78rpx;
  border-radius: 14rpx;
  background: #f0f7ff;
}

.selection-control {
  display: flex;
  position: absolute;
  top: 30rpx;
  left: 10rpx;
  flex: 0 0 42rpx;
  width: 42rpx !important;
  min-width: 42rpx !important;
  max-width: 42rpx !important;
  height: 42rpx !important;
  min-height: 42rpx !important;
  max-height: 42rpx !important;
  margin: 0;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c7c7cc;
  border-radius: 50%;
  background: #ffffff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
}

.selection-control.selected {
  border-color: #0a84ff !important;
  background: #0a84ff !important;
  color: #ffffff !important;
}

.selection-control::after {
  border: 0;
}

.file-chip {
  position: relative;
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 17rpx;
  background: #eef6ff;
  color: #0a84ff;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.folder-chip {
  background: #eef6ff;
  color: #0a84ff;
}

.folder-glyph {
  position: absolute;
  top: 21rpx;
  left: 10rpx;
  width: 48rpx;
  height: 35rpx;
  border-radius: 6rpx;
  background: #0a84ff;
  transition: transform 160ms ease, background-color 160ms ease;
}

.folder-tab {
  position: absolute;
  top: -5rpx;
  left: 3rpx;
  width: 18rpx;
  height: 8rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #0a84ff;
}

.folder-opening {
  border-radius: 12rpx;
  background: #f0f7ff;
  transform: translateX(4rpx);
}

.folder-opening .folder-glyph,
.folder-opening .folder-tab {
  background: #0066cc;
}

.folder-opening .folder-glyph {
  transform: scale(1.12) rotate(-4deg);
}

.file-main {
  min-width: 0;
  flex: 1;
  padding-top: 2rpx;
}

.file-name {
  display: block;
  overflow: hidden;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-time {
  flex: 0 0 156rpx;
  width: 156rpx;
  max-width: 156rpx;
  margin: 2rpx 8rpx 0 10rpx;
  overflow: hidden;
  color: #8e8e93;
  font-size: 23rpx;
  line-height: 40rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.folder-arrow {
  flex: 0 0 auto;
  margin: 4rpx 0 0 8rpx;
  color: #aeaeb2;
  font-size: 34rpx;
  line-height: 40rpx;
  transition: transform 160ms ease, color 160ms ease;
}

.folder-opening .folder-arrow {
  color: #0a84ff;
  transform: translateX(4rpx) rotate(90deg);
}

.file-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  display: flex;
  gap: 14rpx;
}

.row-action {
  flex: 1;
  min-width: 0;
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #f5f5f7;
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.recover-action {
  background: #eef6ff;
  color: #0a84ff;
}

.permanent-action {
  background: #fff1f0;
  color: #ff3b30;
}

.dock {
  position: fixed;
  right: 22rpx;
  bottom: env(safe-area-inset-bottom);
  left: 22rpx;
  z-index: 10;
  padding: 7rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 28rpx rgba(29, 29, 31, 0.12);
  display: flex;
  gap: 8rpx;
}

.dock-secondary,
.dock-primary {
  min-height: 78rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.dock-icon {
  display: inline-block;
  margin-right: 10rpx;
  font-size: 34rpx;
  font-weight: 400;
  vertical-align: -2rpx;
}

.dock-secondary {
  width: 34%;
  border: 1rpx solid #d2d2d7;
  background: #ffffff;
  color: #1d1d1f;
}

.dock-primary {
  flex: 1;
  background: #0a84ff;
  color: #ffffff;
}

.batch-delete-button {
  background: #ff3b30;
}

.batch-delete-button[disabled] {
  background: #d2d2d7;
  color: #8e8e93;
}

@media (max-width: 360px) {
  .index-page {
    padding-right: 16rpx;
    padding-left: 16rpx;
  }

  .workspace-card {
    padding-right: 14rpx;
    padding-left: 14rpx;
  }

  .page-title {
    font-size: 38rpx;
  }

  .file-actions {
    gap: 4rpx;
  }

  .file-time,
  .list-header text:last-child {
    width: 150rpx;
    flex-basis: 150rpx;
  }

  .row-action {
    min-width: 64rpx;
    padding: 0 8rpx;
    font-size: 18rpx;
  }
}
